# =====================================================
# SEPAY PAYMENT GATEWAY CONFIGURATION
# =====================================================
# Sandbox credentials from Sepay
# Get these from: https://dashboard.sandbox.sepay.vn/
SEPAY_API_KEY=replace_with_sepay_api_key
SEPAY_SECRET=replace_with_sepay_secret
SEPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# API Endpoints (sandbox → production endpoint on deploy)
SEPAY_API_BASE=https://api.sandbox.sepay.vn/

# Public URLs (for ngrok local dev OR real domain for production)
# Example: https://xxxx-xxxx-xxxx.ngrok-free.dev (from: ngrok http 8080)
PUBLIC_BASE_URL=https://replace_with_ngrok_url_or_domain
RETURN_URL=https://replace_with_ngrok_url_or_domain/payment/return

# =====================================================
# SPRING SECURITY / JWT
# =====================================================
APP_SECURITY_ENABLED=true
APPLICATION_SECURITY_JWT_SECRET_KEY=replace_with_jwt_secret_key
APPLICATION_SECURITY_JWT_EXPIRATION=86400000
APPLICATION_SECURITY_JWT_REFRESH_EXPIRATION=604800000
