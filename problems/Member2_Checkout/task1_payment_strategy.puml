@startuml
title Sequence Diagram for Member 2: Payment Process (Strategy Pattern)
autonumber

actor Customer
participant "UI:CheckoutPage" as UI
participant "CheckoutController" as CC
participant "CartService" as CS
participant "PaymentFactory:PaymentStrategyFactory" as PF
participant "Strategy:PaymentStrategy" as PS
participant "Order" as O
database DB

Customer -> UI : Chọn phương thức thanh toán & Đặt hàng
activate UI
UI -> CC : placeOrder(itemIds, paymentMethod, ...)
activate CC

CC -> CS : checkoutWithOptions(customer, itemIds, paymentMethod, ...)
activate CS

CS -> CS : calculateTotal(items)
note right: Tính toán tổng tiền sau khi áp dụng Discount Strategy

CS -> PF : getStrategy(paymentMethod)
activate PF
PF -> PS** : new CashPaymentStrategy() / new BankTransferPaymentStrategy()
PF --> CS : strategy
deactivate PF

CS -> PS : processPayment(finalTotal)
activate PS
PS -> PS : validatePayment(order)
PS --> CS : done
deactivate PS

CS -> O** : Initialize Order (via Builder)
CS -> O : setPaymentStatus(PAID / UNPAID)
CS -> DB : save(order)
activate DB
DB --> CS : saved
deactivate DB

CS --> CC : order
deactivate CS

CC --> UI : Redirect to Success / Order History
deactivate CC
UI --> Customer : Hiển thị thông báo thành công
deactivate UI

@enduml
