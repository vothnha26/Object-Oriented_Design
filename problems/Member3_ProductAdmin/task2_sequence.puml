@startuml task2_sequence
title Sequence Diagram for Task 2: Admin Operations (Command Pattern & Undo)
autonumber

actor Admin
participant ":AdminProductController" as APC
participant "cmd:SoftDeleteProductCommand" as CMD
participant ":AdminCommandInvoker" as INV
participant ":ProductRepository" as REPO
database DB

== Execute Soft Delete ==
Admin -> APC : delete(id)
activate APC

APC -> CMD** : new SoftDeleteProductCommand(repo, id)
APC -> INV : execute(cmd)
activate INV

INV -> CMD : execute()
activate CMD

CMD -> REPO : findById(id)
activate REPO
REPO --> CMD : p
deactivate REPO

CMD -> CMD : Save previous status
CMD -> REPO : save(p)
activate REPO
REPO -> DB : UPDATE Product\nSET status=INACTIVE
REPO --> CMD : saved
deactivate REPO

CMD --> INV : done
deactivate CMD

INV -> INV : push(cmd) to history stack
INV --> APC : success
deactivate INV

APC --> Admin : Redirect with success message
deactivate APC

== Undo Last Action ==
Admin -> APC : undoLastAction() [POST /undo]
activate APC

APC -> INV : undo()
activate INV

INV -> INV : cmd = history.pop()
INV -> CMD : undo()
activate CMD

CMD -> REPO : findById(id)
activate REPO
REPO --> CMD : p
deactivate REPO

CMD -> CMD : Restore previous status
CMD -> REPO : save(p)
activate REPO
REPO -> DB : UPDATE Product\nSET status=previousStatus
REPO --> CMD : saved
deactivate REPO

CMD --> INV : done
deactivate CMD

INV --> APC : true
deactivate INV

APC --> Admin : Redirect with undo success message
deactivate APC

@enduml
