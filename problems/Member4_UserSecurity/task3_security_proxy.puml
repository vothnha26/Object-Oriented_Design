@startuml task3_security_proxy
title Sequence Diagram for Member 4: Ownership Security (Proxy Pattern)
autonumber

actor User
participant "CheckoutController" as CC
participant "Proxy:CheckoutOperationsProxy" as PROXY
participant "Real:CheckoutOperationsImpl" as REAL
participant "Repo:OrderItemRepository" as REPO
database DB

User -> CC : updateQuantity(itemId, quantity)
activate CC

CC -> PROXY : updateQuantity(customer, itemId, quantity)
activate PROXY

PROXY -> REPO : findById(itemId)
activate REPO
REPO --> PROXY : orderItem
deactivate REPO

PROXY -> PROXY : validateOwnership(customer, orderItem)
note right: Compare customer.id with orderItem.order.customer.id

alt If ownership is valid
    PROXY -> REAL : updateQuantity(customer, itemId, quantity)
    activate REAL
    REAL -> DB : UPDATE OrderItem
    REAL --> PROXY : done
    deactivate REAL
    PROXY --> CC : success
else If NOT ownership (Security Breach)
    PROXY -> PROXY : log.warn("SECURITY BREACH")
    PROXY --[#red]> CC : throw SecurityException
end

deactivate PROXY
CC --> User : Redirect / Error message
deactivate CC

@enduml
