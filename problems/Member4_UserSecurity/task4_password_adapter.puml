@startuml
title Sequence Diagram for Member 4: Legacy Password Support (Adapter Pattern)
autonumber

participant "Spring Security" as SS
participant "Adapter:LegacyPasswordEncoderAdapter" as LEA
participant "BCrypt:BCryptPasswordEncoder" as BC

SS -> LEA : matches(raw, encoded)
activate LEA

alt If encoded starts with {bcrypt}
    LEA -> LEA : strip prefix
    LEA -> BC : matches(raw, stripped)
    BC --> LEA : result
else If encoded starts with {noop}
    LEA -> LEA : strip prefix
    LEA -> LEA : raw.equals(stripped)
else If encoded starts with $2a$ / $2b$ / $2y$ (Standard BCrypt)
    LEA -> BC : matches(raw, encoded)
    BC --> LEA : result
else Legacy Plaintext
    LEA -> LEA : raw.equals(encoded)
end

LEA --> SS : result (boolean)
deactivate LEA

@enduml
