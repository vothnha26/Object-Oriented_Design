@startuml
title Sequence Diagram for Member 4: User Creation (Factory Pattern)
autonumber

actor Admin
participant "CreateAdminInitializer" as CAI
participant "RegistrationController" as RC
participant "UserFactory" as UF
participant "Customer" as C
participant "Employee" as E
participant "Encoder:PasswordEncoder" as ENC
database DB

== Admin Seeding ==
CAI -> UF : createAdmin(username, email, password, phone)
activate UF
UF -> ENC : encode(password)
ENC --> UF : hashed
UF -> C** : new Customer(status=ACTIVE)
UF --> CAI : adminEntity
deactivate UF
CAI -> DB : save(adminEntity)

== Customer Registration ==
Admin -> RC : register(form)
activate RC
RC -> UF : createCustomer(u, e, name, p, pass, PENDING)
activate UF
UF -> ENC : encode(pass)
ENC --> UF : hashed
UF -> C** : new Customer(status=PENDING)
UF --> RC : customerEntity
deactivate UF
RC -> DB : save(customerEntity)
RC --> Admin : redirect to verify OTP
deactivate RC

@enduml
