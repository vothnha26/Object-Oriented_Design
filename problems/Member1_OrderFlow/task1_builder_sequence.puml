@startuml task1_builder_sequence
title Sequence Diagram for Task 1: Order Creation (Builder Pattern via Factory)
autonumber

actor Client
participant "CheckoutController" as CC
participant "Facade:CheckoutFacade" as CF
participant "Factory:OrderFactory" as OF
participant "Builder:OrderBuilder" as OB
participant "Order" as O
database DB

== Checkout Process ==
Client -> CC : Submit order request
activate CC

CC -> CF : processCheckout(customer, request)
activate CF

CF -> OF : createOrder(customer, cartItems, note)
activate OF

OF -> OB : builder()
activate OB
OF -> OB : forCustomer(customer)
OF -> OB : withItems(orderItems)
OF -> OB : build()

OB -> O** : new Order()
OB -> O : setCustomer(c), setStatus(PENDING)...
OB --> OF : order
deactivate OB

OF --> CF : order
deactivate OF

CF -> DB : save(order)
activate DB
DB --> CF : savedOrder
deactivate DB

CF --> CC : finalOrder
deactivate CF

CC --> Client : Display Order Status / Payment QR
deactivate CC

@enduml
