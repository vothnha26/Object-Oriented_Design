@startuml
title Sequence Diagram for Task 1: Order Checkout (Builder Pattern)
autonumber

actor Customer
participant "UI:CheckoutPage" as UI
participant "CheckoutController" as CC
participant "CartService" as CS
participant "OrderBuilder" as OB
participant "Order" as O
database DB

Customer -> UI : Submit Checkout Form
activate UI
UI -> CC : placeOrder(itemIds, paymentMethod, ...)
activate CC

CC -> CS : checkoutWithOptions(customer, itemIds, ...)
activate CS

CS -> CS : getOrCreateActiveCart(customer)
CS -> DB : findItems(itemIds)

note over OB: Member 1: Builder Pattern
CS -> OB : builder()
activate OB
CS -> OB : forCustomer(customer)
CS -> OB : payBy(paymentMethod)
CS -> OB : receivingMethod(receivingMethod)
CS -> OB : shipTo(name, phone, address)
CS -> OB : withSubtotal(total)
CS -> OB : build()

OB -> O** : new Order()
OB -> O : setCustomer, setPayment, setShippingInfo...
OB --> CS : order
deactivate OB

CS -> DB : save(order)
activate DB
DB --> CS : savedOrder
deactivate DB

loop for each CartItem
    CS -> DB : save(OrderItem)
    CS -> DB : save(OrderedTopping)
end

CS -> DB : updateCartStatus(CHECKED_OUT)
CS --> CC : order
deactivate CS

CC --> UI : Redirect to Success Page
deactivate CC
UI --> Customer : Display Order Success
deactivate UI

@enduml
