@startuml
title Sequence Diagram for Task 1: Product Pricing (Decorator Pattern)
autonumber

actor Client
participant ":CartService" as CS
participant "basePrice:BasePrice" as BP
participant "promoDec:PromotionDecorator" as PD
participant "toppingDec:ToppingDecorator" as TD
participant "qtyDec:QuantityDecorator" as QD
database DB

Client -> CS : addItemWithOptions(cartId, variantId, qty, toppings, note)
activate CS

CS -> CS : // 1. Resolve unit price (Base + Promo)
CS -> BP** : new BasePrice(variant.getPrice())
alt discountPercent > 0
    CS -> PD** : new PromotionDecorator(basePrice, discountPercent)
end
CS -> PD : calculate()
PD --> CS : unitPrice

CS -> DB : Save CartItem (unitPrice)

CS -> CS : // 2. Trigger Recompute (Crucial Step)
activate CS
CS -> CS : recomputeLineTotal(item)

CS -> DB : Fetch current SelectedToppings
DB --> CS : selectedToppingsList

CS -> CS : // 3. Build full Decorator Chain
CS -> BP** : new BasePrice(item.unitPrice)
alt toppings not empty
    CS -> TD** : new ToppingDecorator(currentChain, toppingMap)
end
CS -> QD** : new QuantityDecorator(currentChain, item.qty)

CS -> CS : // 4. Calculate Final Line Total
CS -> QD : calculate()
activate QD
QD -> TD : calculate()
activate TD
TD -> PD : calculate()
activate PD
PD -> BP : calculate()
activate BP
BP --> PD : base
deactivate BP
PD --> TD : discounted
deactivate PD
TD --> QD : withToppings
deactivate TD
QD --> CS : finalLineTotal
deactivate QD

CS -> DB : Update CartItem (lineTotal)
deactivate CS

CS --> Client : Success
deactivate CS

@enduml
